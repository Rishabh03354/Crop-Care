# ---------------------------------------------------------------------------
# Crop Care Crop — backend environment template
# Copy to `.env` (cp .env.example .env / copy .env.example .env) and adjust.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=crop-care-backend
APP_VERSION=0.3.0
ENVIRONMENT=local                       # local | development | staging | production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS: comma-separated allowed frontend origins (Next.js / React dev server) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Image uploads ---
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database first (see README), then fill in your credentials.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crop_care
DB_ECHO=false                           # true logs every SQL statement (verbose — dev only)

# ---------------------------------------------------------------------------
# Reserved for later milestones — the code does not read these yet:
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crop_care_test
# ML_MODEL_DIR=ml_models
# ML_DEVICE=cpu
